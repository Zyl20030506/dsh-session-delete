{
  "name": "dsh-session-delete",
  "version": "1.0.0",
  "type": "module",
  "description": "A recycle bin for DeepSeek Harness sessions: a red menu row moves a session into a 3-day bin that can be restored or purged from the sidebar foot.",
  "license": "MIT",
  "author": "zyl54",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zyl20030506/dsh-session-delete.git"
  },
  "homepage": "https://github.com/Zyl20030506/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/Zyl20030506/dsh-session-delete/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "session",
    "recycle-bin",
    "trash"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/trash.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
